# Server & Runtime
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Telegram Bot (grammY webhook mode)
BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
BOT_USERNAME="YourP2PBot"
WEBHOOK_SECRET_TOKEN="YOUR_RANDOM_WEBHOOK_SECRET"

# PostgreSQL (Render / Neon / Supabase)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Admin Controls
ADMIN_GROUP_ID="-1001234567890"
ADMIN_IDS="123456789,987654321"
ADMIN_API_KEY="CHANGE_THIS_STRONG_ADMIN_SECRET"

# Marketplace Rules & Commission
COMMISSION_PERCENT=3
DEFAULT_REFERENCE_RATE_ETB=194.00
DEFAULT_DAILY_LIMIT_USDT=500
MAX_DISPUTES_BEFORE_SUSPEND=3

# Deposit Addresses (TRC20 & BEP20)
DEPOSIT_ADDRESS_TRC20="TYourPlatformTRC20WalletAddressHere"
DEPOSIT_ADDRESS_BEP20="0xYourPlatformBEP20WalletAddressHere"

# Security & CORS (comma-separated origins, e.g. GitHub Pages origin)
MINI_APP_ORIGIN="https://yourusername.github.io"
ALLOW_DEV_PREVIEW=true
